function checkX takes real x returns real       //判断X坐标是否出界,出界返回边界值
local real r=GetRectMinX(bj_mapInitialPlayableArea)+50
if(x<r)then
return r
endif
set r=GetRectMaxX(bj_mapInitialPlayableArea)-50
if(x>r)then
return r
endif
return x
endfunction
function checkY takes real y returns real       //判断Y坐标是否出界,出界返回边界值
local real r=GetRectMinY(bj_mapInitialPlayableArea)+50
if(y<r)then
return r
endif
set r=GetRectMaxY(bj_mapInitialPlayableArea)-50
if(y>r)then
return r
endif
return y
endfunction

