//===========================================================================
// Trigger: solareditr
//===========================================================================
function Trig_solareditrActions takes nothing returns nothing
endfunction
//===========================================================================
function InitTrig_solareditr takes nothing returns nothing
    set gg_trg_solareditr=CreateTrigger()
    call TriggerAddAction(gg_trg_solareditr, function Trig_solareditrActions)
endfunction

//===========================================================================
// Trigger: gouhe
//===========================================================================
function Trig_gouhe_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_gouhe_Actions takes nothing returns nothing
    set udg_tarloc = GetSpellTargetLoc()
    set udg_triunitloc = GetUnitLoc(GetTriggerUnit())
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_loc = PolarProjectionBJ(udg_triunitloc, I2R(( GetForLoopIndexA() * 60 )), AngleBetweenPoints(udg_triunitloc, udg_tarloc))
        call MoveLocation(udg_loc,checkX(GetLocationX(udg_loc)),checkY(GetLocationY(udg_loc)))
        // 此处JASS为判断边界,超出边界使udg_loc为边界值,新手可不用
        call CreateDestructableLoc( 'B000', udg_loc, GetRandomReal(0.00, 360.00), 0.50, GetRandomInt(0, 2) )
        set udg_dummy[GetForLoopIndexA()] = GetLastCreatedDestructable()
        call AddSpecialEffectLocBJ( udg_loc, "Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation(udg_loc)
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 8.00 )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 20
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call RemoveDestructable( udg_dummy[GetForLoopIndexB()] )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    call RemoveLocation(udg_tarloc)
    call RemoveLocation(udg_triunitloc)
endfunction

//===========================================================================
function InitTrig_gouhe takes nothing returns nothing
    set gg_trg_gouhe = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_gouhe, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_gouhe, Condition( function Trig_gouhe_Conditions ) )
    call TriggerAddAction( gg_trg_gouhe, function Trig_gouhe_Actions )
endfunction

//===========================================================================
function InitCustomTriggers takes nothing returns nothing
    call InitTrig_solareditr()
    call InitTrig_gouhe(  )
endfunction
